# Local hosting bootstrap: copy to `.env` and fill in. Never commit `.env`.
# Used by `bin/setup-cloudflare-hosting.sh` (auto-sourced when present).
# CI uses GitHub Actions secrets/vars instead.
#
# Zone for mzworthington.co.uk is owned by edge-dns; this product owns the
# Worker + monitor.mzworthington.co.uk custom domain.

PULUMI_STACK=prod

# Existing active Cloudflare zone name (created/managed in edge-dns)
DOMAIN=mzworthington.co.uk

# Comma-separated hostnames attached to the Worker (Pages-shaped env names for
# shared edge-dns bootstrap; Pulumi maps these to workerName / workerHostnames)
PAGES_HOSTNAMES=monitor.mzworthington.co.uk

# Worker script name (also used for *.workers.dev)
PAGES_PROJECT_NAME=gpio-build-monitor

# Required for API calls (or provide via Bitwarden Secrets Manager)
# CLOUDFLARE_API_TOKEN=

# Optional: script can resolve these from the API token
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# Optional: script can mint one after `pulumi login`
# PULUMI_ACCESS_TOKEN=

# Optional Bitwarden Secrets Manager
# BWS_ACCESS_TOKEN=
# BWS_PROJECT_ID=
