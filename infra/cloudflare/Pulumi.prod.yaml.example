config:
  # Fill via bin/setup-cloudflare-hosting.sh (writes gitignored Pulumi.<stack>.yaml).
  gpio-build-monitor:accountId: YOUR_CLOUDFLARE_ACCOUNT_ID
  gpio-build-monitor:zoneId: YOUR_CLOUDFLARE_ZONE_ID
  gpio-build-monitor:pagesProjectName: gpio-build-monitor
  gpio-build-monitor:pagesHostnames:
    - monitor.mzworthington.co.uk
