<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if refresh_seconds > 0 %}
  <meta http-equiv="refresh" content="{{ refresh_seconds }}">
  {% endif %}
  <title>Build monitor</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body data-status="{{ status }}">
  <div class="atmosphere" aria-hidden="true"></div>
  <main>
    <header class="masthead">
      <img class="brand-mark" src="/logo.svg" width="64" height="64" alt="">
      <h1>Build monitor</h1>
      <p id="connection" class="connection" data-state="{{ connection_state }}">{{ connection_label }}</p>
      <p
        id="last-checked"
        class="last-checked"
        data-last-checked-at="{{ last_checked_at if last_checked_at is not none else '' }}"
      >{{ last_checked_label }}</p>
    </header>

    <section class="hero">
      <div
        class="status-dial"
        id="status-dial"
        data-status="{{ status }}"
        data-poll-seconds="{{ poll_in_seconds }}"
        data-next-check-at="{{ next_check_at if next_check_at is not none else '' }}"
        data-fetching="{{ 'true' if fetching else 'false' }}"
      >
        <svg class="status-dial-ring" viewBox="0 0 100 100" aria-hidden="true">
          <circle class="status-dial-track" cx="50" cy="50" r="46"></circle>
          <circle
            class="status-dial-progress"
            id="ticker-progress"
            cx="50"
            cy="50"
            r="46"
            pathLength="1"
          ></circle>
        </svg>
        <div class="status-dial-core">
          <p id="status-word" class="status-word">{{ status_word }}</p>
          <p id="summary" class="summary">{{ summary }}</p>
        </div>
      </div>
    </section>

    <div class="lights" aria-label="Signal lights" aria-live="polite">
      <div class="light{% if fetching %} on{% endif %}" data-light="blue" title="Fetching">
        <span class="bulb"></span>
        <span class="label">Fetch</span>
      </div>
      <div class="light{% if green_on %} on{% endif %}" data-light="green" title="Pass">
        <span class="bulb"></span>
        <span class="label">Pass</span>
      </div>
      <div class="light{% if yellow_on %} on pulse{% endif %}" data-light="yellow" title="Running">
        <span class="bulb"></span>
        <span class="label">Run</span>
      </div>
      <div class="light{% if red_on %} on{% endif %}" data-light="red" title="Fail">
        <span class="bulb"></span>
        <span class="label">Fail</span>
      </div>
      <div class="light{% if purple_on %} on{% endif %}" data-light="purple" title="Connection error">
        <span class="bulb"></span>
        <span class="label">Error</span>
      </div>
    </div>

    <section id="issues" class="issues" aria-label="Attention"{% if not issues %} hidden{% endif %}>
      <div class="issues-head">
        <h2>Needs attention</h2>
        <p id="issue-count" class="issue-count">{% if issues %}{{ issues|length }} open{% endif %}</p>
      </div>
      <ul id="issue-list">
        {% for issue in issues %}
        <li class="issue issue-{{ issue.status|lower }}" style="--delay: {{ loop.index0 * 40 }}ms">
          {% set parts = issue.repo.split('/') %}
          {% if issue.url %}
          <a href="{{ issue.url }}" target="_blank" rel="noopener noreferrer">
            <span class="issue-repo">
              {% if parts|length == 2 %}
              <span class="issue-org">{{ parts[0] }}/</span><span class="issue-name">{{ parts[1] }}</span>
              {% else %}
              {{ issue.repo }}
              {% endif %}
            </span>
            <span class="issue-workflow">{{ issue.workflow }}</span>
            <span class="issue-status">{{ issue.status }}</span>
          </a>
          {% else %}
          <span class="issue-repo">
            {% if parts|length == 2 %}
            <span class="issue-org">{{ parts[0] }}/</span><span class="issue-name">{{ parts[1] }}</span>
            {% else %}
            {{ issue.repo }}
            {% endif %}
          </span>
          <span class="issue-workflow">{{ issue.workflow }}</span>
          <span class="issue-status">{{ issue.status }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
  </main>
  <script src="/countdown.js"></script>
  <script src="/app.js"></script>
</body>
</html>
