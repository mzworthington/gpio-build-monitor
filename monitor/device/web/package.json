{
  "name": "gpio-build-monitor",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "deploy": "pnpm build:web && wrangler pages deploy ./public --project-name gpio-build-monitor",
    "deploy:api": "wrangler deploy",
    "dev": "esbuild src/web/start.ts --bundle --outfile=./public/monitor.js --format=iife --sourcemap --watch --servedir=./public",
    "dev:worker": "wrangler dev",
    "build:web": "esbuild src/web/start.ts --bundle --outfile=./public/monitor.js --format=iife",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250807.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "4.120.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "1.0.2",
    "alpinejs": "^3.17.2"
  }
}
