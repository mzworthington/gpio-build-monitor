#!/usr/bin/env bash
# Local Python API + built TypeScript frontend (served by the API on the same origin).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ ! -d .venv ]]; then
  "$ROOT/bin/bootstrap"
fi

# shellcheck disable=SC1091
source .venv/bin/activate

if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

CONF_FILE="${CONF_FILE:-monitor/api/monitor/integrations.yaml}"
LOG_LEVEL="${LOG_LEVEL:-debug}"

monitor_pid=""

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM
  if [[ -n "${monitor_pid}" ]] && kill -0 "${monitor_pid}" 2>/dev/null; then
    kill "${monitor_pid}" 2>/dev/null || true
    wait "${monitor_pid}" 2>/dev/null || true
  fi
  exit "${exit_code}"
}
trap cleanup EXIT INT TERM

wait_for_port() {
  local host="$1"
  local port="$2"
  local pid="$3"
  local label="$4"
  python - "${host}" "${port}" "${pid}" "${label}" <<'PY'
import errno
import os
import socket
import sys
import time

host, port_s, pid_s, label = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
port = int(port_s)
pid = int(pid_s)
deadline = time.time() + 60
while time.time() < deadline:
    try:
        os.kill(pid, 0)
    except OSError:
        sys.exit(1)
    try:
        with socket.create_connection((host, port), timeout=0.5):
            sys.exit(0)
    except OSError as exc:
        if exc.errno not in {errno.ECONNREFUSED, errno.ETIMEDOUT, errno.EHOSTUNREACH}:
            pass
    time.sleep(0.2)
print(f"Timed out waiting for {label} on {host}:{port}", file=sys.stderr)
sys.exit(1)
PY
}

ensure_frontend() {
  local web="$ROOT/monitor/device/web"
  if [[ ! -f "$web/package.json" ]]; then
    echo "error: monitor/device/web/package.json not found" >&2
    exit 1
  fi
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "error: pnpm is required to build the frontend." >&2
    exit 1
  fi
  if [[ ! -d "$web/node_modules" ]]; then
    echo "Installing frontend dependencies (pnpm install)"
    (cd "$web" && pnpm install)
  fi
  echo "Building frontend (pnpm build:web)"
  (cd "$web" && pnpm build:web)
}

read_ws() {
  python - "$CONF_FILE" <<'PY'
import sys
from pathlib import Path

import yaml

path = Path(sys.argv[1])
if not path.is_file():
    print(f"error\tConfig file not found: {path}", file=sys.stderr)
    sys.exit(1)

raw = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
ws = ((raw.get("outputs") or {}).get("websocket")) or {}
enabled = bool(ws.get("enabled", False)) if isinstance(ws, dict) else False
host = str((ws or {}).get("host") or "127.0.0.1")
try:
    port = int((ws or {}).get("port") or 8080)
except (TypeError, ValueError):
    port = 8080
browse_host = "127.0.0.1" if host in {"0.0.0.0", "::", "[::]"} else host
print(f"{'1' if enabled else '0'}\t{browse_host}\t{port}")
PY
}

ensure_frontend

echo "Starting Python API (conf=${CONF_FILE}, log=${LOG_LEVEL})"
monitor run \
  --log-level "${LOG_LEVEL}" \
  --conf "${CONF_FILE}" \
  "$@" &
monitor_pid=$!

ws_info="$(read_ws)"
IFS=$'\t' read -r ws_enabled ws_host ws_port <<<"${ws_info}"

if [[ "${ws_enabled}" != "1" ]]; then
  echo "WebSocket API disabled in ${CONF_FILE} (outputs.websocket.enabled)."
  wait "${monitor_pid}"
  exit $?
fi

ws_url="http://${ws_host}:${ws_port}"
echo "Python API + Alpine UI: ${ws_url}/"
echo "Snapshot:               ${ws_url}/api/status"

wait_for_port "${ws_host}" "${ws_port}" "${monitor_pid}" "Python API"

wait "${monitor_pid}"
